{
  "workbench.colorCustomizations": {
    "editor.background": "{{ colors.surface.default.hex }}",
    "editor.foreground": "{{ colors.on_surface.default.hex }}",
    "editorLineNumber.foreground": "{{ colors.on_surface_variant.default.hex }}",
    "editorLineNumber.activeForeground": "{{ colors.primary.default.hex }}",
    "editorCursor.foreground": "{{ colors.primary.default.hex }}",
    "editor.selectionBackground": "{{ colors.secondary_container.default.hex }}",
    "editor.inactiveSelectionBackground": "{{ colors.surface_container_high.default.hex }}",
    "editor.lineHighlightBackground": "{{ colors.surface_container_low.default.hex }}",
    "editor.findMatchBackground": "{{ colors.tertiary_container.default.hex }}",
    "editor.findMatchBorder": "{{ colors.tertiary.default.hex }}",
    "editorWidget.background": "{{ colors.surface_container.default.hex }}",
    "editorWidget.border": "{{ colors.outline_variant.default.hex }}",
    "sideBar.background": "{{ colors.surface_container_low.default.hex }}",
    "sideBar.foreground": "{{ colors.on_surface.default.hex }}",
    "activityBar.background": "{{ colors.surface_container.default.hex }}",
    "activityBar.foreground": "{{ colors.primary.default.hex }}",
    "activityBarBadge.background": "{{ colors.primary.default.hex }}",
    "activityBarBadge.foreground": "{{ colors.on_primary.default.hex }}",
    "statusBar.background": "{{ colors.surface_container_high.default.hex }}",
    "statusBar.foreground": "{{ colors.on_surface.default.hex }}",
    "titleBar.activeBackground": "{{ colors.surface_container.default.hex }}",
    "titleBar.activeForeground": "{{ colors.on_surface.default.hex }}",
    "panel.background": "{{ colors.surface.default.hex }}",
    "panel.border": "{{ colors.outline_variant.default.hex }}",
    "terminal.background": "{{ colors.surface.default.hex }}",
    "terminal.foreground": "{{ colors.on_surface.default.hex }}",
    "focusBorder": "{{ colors.primary.default.hex }}"
  },
  "editor.tokenColorCustomizations": {
    "comments": "{{ colors.on_surface_variant.default.hex }}",
    "strings": "{{ colors.tertiary.default.hex }}",
    "keywords": "{{ colors.primary.default.hex }}",
    "numbers": "{{ colors.secondary.default.hex }}",
    "types": "{{ colors.tertiary.default.hex }}",
    "functions": "{{ colors.primary.default.hex }}"
  }
}
