{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Matugen Studio",
  "version": "2.0.0-rc.1",
  "identifier": "io.github.raellx22.matugenstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Matugen Studio",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$CACHE/thumbnails/**",
            "$CACHE/matugen-studio/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "publisher": "raellx22",
    "category": "Utility",
    "shortDescription": "A GUI for generating and applying Matugen themes on Linux.",
    "longDescription": "Matugen Studio is a Linux desktop app for generating Material You color palettes from wallpapers and applying them to KDE Plasma, GTK apps, and supported theme templates.",
    "resources": [
      "resources/matugen-themes/**/*",
      "resources/gtk-themes/**/*",
      "icons/tray.png"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/metainfo/io.github.raellx22.matugenstudio.metainfo.xml": "resources/linux/matugen-studio.appdata.xml"
        }
      }
    }
  }
}
